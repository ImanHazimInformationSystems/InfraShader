# Browser-safe configuration only. Never place service-role or secret keys here.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Browser public pk. token only; configure the actual value in ignored .env.local.
VITE_MAPBOX_ACCESS_TOKEN=
# Set true for the neutral coordinate fallback. No OpenFreeMap fallback is used.
VITE_MAPBOX_OFFLINE=false
# Optional bounded tree lookup. Omit to use public Overpass on explicit user request;
# set to offline to disable. Review service capacity and OSM ODbL/attribution duties.
# VITE_TREE_OVERPASS_URL=offline
# Elevation is opt-in. Map layers uses Mapbox Terrain DEM with the configured account.
# Optional separately licensed raster DEM override:
# Supply both URL and attribution. Encoding: mapbox or terrarium (not a provider).
# VITE_TERRAIN_TILE_URL=https://approved-host.example/dem/{z}/{x}/{y}.png
# VITE_TERRAIN_ATTRIBUTION=Dataset owner and licence
# VITE_TERRAIN_ENCODING=terrarium
