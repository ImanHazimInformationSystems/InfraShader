# Real API only. No demo authentication or fallback database exists.
DATABASE_URL=postgresql+psycopg://infrashader:replace-me@localhost:5432/infrashader
# Project URL, not a service role key. Configure an asymmetric signing key in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Server only; never put this value in a VITE_ variable or chat.
# STORAGE_SERVICE_KEY=<local Supabase service-role key>
# JSON array; explicit local frontend origin, never wildcard with credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Integration tests require a disposable PostGIS database. Never target production.
# TEST_DATABASE_URL=postgresql+psycopg://infrashader:replace-me@localhost:5432/infrashader_test
