# InfraShader web app — production build environment template.
# These values are compiled into public JavaScript. Only browser-safe values belong here:
# never a service-role key, database URL or Storage key.

# Where the browser calls the API. Leave empty only when a reverse proxy serves /api on the
# same origin as the web app.
VITE_API_BASE_URL=https://<api-domain>
# Free API instances can take about a minute to wake up (15–120 seconds allowed).
VITE_API_TIMEOUT_MS=90000

# Supabase project URL and its publishable (anon) key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Public Mapbox token (pk.). Restrict it to the production URL(s) in the Mapbox account.
VITE_MAPBOX_ACCESS_TOKEN=<pk.public-token>
VITE_MAPBOX_OFFLINE=false

# Optional: VITE_TREE_OVERPASS_URL, VITE_TERRAIN_TILE_URL, VITE_TERRAIN_ATTRIBUTION and
# VITE_TERRAIN_ENCODING, as described in apps/web/.env.example. Review licences first.
