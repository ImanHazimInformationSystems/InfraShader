# InfraShader API — production environment template.
# Copy to the server's secret store or an untracked env file. Never commit filled values,
# never put any of these in a VITE_ variable, and never paste them into chat or tickets.

# Application PostgreSQL 15+ with PostGIS 3. Use a non-superuser role that owns the schema.
# Require TLS for a remote database (sslmode=require or verify-full).
DATABASE_URL=postgresql+psycopg://<app_role>:<password>@<db-host>:5432/<database>?sslmode=require

# Supabase project URL (HTTPS, no path). Configure an asymmetric (ES256/RS256) signing key in
# Supabase Auth; the API verifies tokens against this project's JWKS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only key for the private "evidence" Storage bucket. Rotate if it is ever exposed.
STORAGE_SERVICE_KEY=<server-only-secret>

# JSON array of the exact HTTPS origins that serve the web app. No wildcard.
CORS_ORIGINS=["https://<app-domain>"]

# Optional, for scripts/backup.py only: the identity database when you operate it yourself.
# Hosted Supabase keeps its own identity backups; leave unset there.
# AUTH_DATABASE_URL=postgresql://<role>:<password>@<host>:5432/postgres?sslmode=require
